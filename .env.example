# Optional: only needed when you are ready to send email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=use-an-app-password
EMAIL_FROM=your-address@gmail.com
EMAIL_TO=your-address@gmail.com
SMTP_STARTTLS=true

# Runtime settings
JOB_DB_PATH=data/jobs.db
COMPANIES_FILE=config/companies.json
HTTP_TIMEOUT_SECONDS=25
USER_AGENT=HardwareJobMonitor/0.1 (personal job alerts; contact: your-address@example.com)
